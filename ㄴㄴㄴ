/* =====================================================================
   KakaoCloud Tutorial Style for Confluence Wiki — FINAL
   목적
   - Confluence Wiki 작성글을 KakaoCloud Tutorial 문서 톤으로 통일
   - 기본 Markdown/Confluence Macro만으로 자연스럽게 작동
   - 제목, 본문, 목록, 표, 코드, 이미지, 첨부, 안내 매크로, TOC, 다크모드 지원

   적용
   - 기존 커스텀 CSS 전체 삭제 후 이 파일 전체 붙여넣기
   - 별도 HTML 클래스 없이 기본 Wiki 요소 중심으로 동작
   ===================================================================== */


/* =====================================================================
   01. DESIGN TOKENS
   ===================================================================== */
:root {
  /* -------------------------------------------------------------------
     Typography
     ------------------------------------------------------------------- */
  --kc-font:
    -apple-system,
    BlinkMacSystemFont,
    "Apple SD Gothic Neo",
    "Noto Sans KR",
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;

  --kc-mono:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    Menlo,
    Monaco,
    monospace;

  /* -------------------------------------------------------------------
     Font size
     ------------------------------------------------------------------- */
  --kc-font-xs: 12px;
  --kc-font-sm: 14px;
  --kc-font-md: 16px;
  --kc-font-lg: 18px;
  --kc-font-xl: 20px;
  --kc-font-2xl: 24px;
  --kc-font-3xl: 30px;
  --kc-font-4xl: 32px;

  /* -------------------------------------------------------------------
     Font weight
     ------------------------------------------------------------------- */
  --kc-weight-regular: 400;
  --kc-weight-medium: 500;
  --kc-weight-semibold: 600;
  --kc-weight-bold: 700;

  /* -------------------------------------------------------------------
     Line height
     ------------------------------------------------------------------- */
  --kc-line-tight: 1.35;
  --kc-line-heading: 1.45;
  --kc-line-body: 1.7;
  --kc-line-code: 1.65;

  /* -------------------------------------------------------------------
     Text colors
     KakaoCloud tutorial reference:
     - heading / emphasis: dark
     - body: #424242 range
     - secondary: #727272 range
     ------------------------------------------------------------------- */
  --kc-text-strong: #111111;
  --kc-text-heading: #242424;
  --kc-text-default: #424242;
  --kc-text-subtle: #727272;
  --kc-text-placeholder: #a3a3a3;
  --kc-text-disabled: #bcbcbc;
  --kc-text-inverse: #ffffff;

  /* -------------------------------------------------------------------
     Brand colors
     ------------------------------------------------------------------- */
  --kc-blue-900: #1b64da;
  --kc-blue-800: #2468d8;
  --kc-blue-700: #3182f6;
  --kc-blue-600: #4b96f7;
  --kc-blue-100: #eaf3ff;
  --kc-blue-50: #f5f9ff;

  --kc-link-default: #3182f6;
  --kc-link-hover: #1b64da;
  --kc-link-visited: #3182f6;

  /* -------------------------------------------------------------------
     Surface colors
     ------------------------------------------------------------------- */
  --kc-surface-base: #ffffff;
  --kc-surface-subtle: #fafafa;
  --kc-surface-muted: #f7f8fa;
  --kc-surface-code: #f6f8fa;
  --kc-surface-code-header: #eef1f4;

  /* -------------------------------------------------------------------
     Border colors
     ------------------------------------------------------------------- */
  --kc-border-subtle: #f0f0f0;
  --kc-border-default: #e7e7e7;
  --kc-border-strong: #d9d9d9;
  --kc-border-code: #e2e5e9;

  /* -------------------------------------------------------------------
     Semantic colors
     ------------------------------------------------------------------- */
  --kc-info-bg: #eff9ff;
  --kc-info-border: #9edfff;
  --kc-info-accent: #43b8e8;
  --kc-info-text: #155f82;

  --kc-success-bg: #f0fbf4;
  --kc-success-border: #9ce1b1;
  --kc-success-accent: #43b96b;
  --kc-success-text: #176b3a;

  --kc-warning-bg: #fffaeb;
  --kc-warning-border: #f6d365;
  --kc-warning-accent: #f2ad16;
  --kc-warning-text: #815900;

  --kc-danger-bg: #fff3f3;
  --kc-danger-border: #ffb8b8;
  --kc-danger-accent: #f05252;
  --kc-danger-text: #a63030;

  /* -------------------------------------------------------------------
     Radius
     - 4px: inline code / compact tag
     - 8px: image / code / alert / table
     - 12px: compact grouped UI
     - 16px: card / hero / tutorial visual unit
     ------------------------------------------------------------------- */
  --kc-radius-xs: 4px;
  --kc-radius-sm: 8px;
  --kc-radius-md: 12px;
  --kc-radius-lg: 16px;

  /* -------------------------------------------------------------------
     Shadows
     ------------------------------------------------------------------- */
  --kc-shadow-none: none;
  --kc-shadow-card: 0 2px 8px rgba(0, 0, 0, 0.04);
  --kc-shadow-card-hover: 0 6px 18px rgba(0, 0, 0, 0.09);
  --kc-shadow-image: 0 2px 6px rgba(0, 0, 0, 0.06);

  /* -------------------------------------------------------------------
     Layout
     ------------------------------------------------------------------- */
  --kc-header-h: 56px;
  --kc-content-gap-xs: 8px;
  --kc-content-gap-sm: 12px;
  --kc-content-gap-md: 16px;
  --kc-content-gap-lg: 24px;
  --kc-content-gap-xl: 32px;
  --kc-content-gap-2xl: 48px;
  --kc-content-gap-3xl: 64px;
}


/* =====================================================================
   02. BASE / RESET
   ===================================================================== */
body.page.viewcontent .wiki-content,
#content .wiki-content {
  color: var(--kc-text-default);
  font-family: var(--kc-font);
  font-size: var(--kc-font-md);
  font-weight: var(--kc-weight-regular);
  line-height: var(--kc-line-body);
  letter-spacing: -0.01em;
  word-break: keep-all;
  overflow-wrap: break-word;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body.page.viewcontent .wiki-content *,
#content .wiki-content * {
  box-sizing: border-box;
}

body.page.viewcontent .wiki-content ::selection,
#content .wiki-content ::selection {
  background: #dbeafe;
  color: var(--kc-text-strong);
}


/* =====================================================================
   03. CONFLUENCE HEADER / TITLE
   ===================================================================== */
#breadcrumb-section {
  display: block;
  position: static;
  background: transparent;
}

#title-text {
  color: var(--kc-text-strong);
  font-family: var(--kc-font);
  font-size: var(--kc-font-3xl);
  font-weight: var(--kc-weight-bold);
  letter-spacing: -0.03em;
  line-height: var(--kc-line-tight);
}

.pagination-actions,
#action-menu,
#action-menu-link,
[id*="Link"]:has(#editPageLink),
#title-heading ~ * #editPageLink,
body #editPageLink {
  position: relative;
  z-index: 500;
}


/* =====================================================================
   04. HEADING SYSTEM
   ===================================================================== */
body.page.viewcontent .wiki-content h1,
body.page.viewcontent .wiki-content h2,
body.page.viewcontent .wiki-content h3,
body.page.viewcontent .wiki-content h4,
body.page.viewcontent .wiki-content h5,
body.page.viewcontent .wiki-content h6,
#content .wiki-content h1,
#content .wiki-content h2,
#content .wiki-content h3,
#content .wiki-content h4,
#content .wiki-content h5,
#content .wiki-content h6 {
  color: var(--kc-text-strong);
  font-family: var(--kc-font);
  letter-spacing: -0.025em;
  scroll-margin-top: calc(var(--kc-header-h) + 20px);
}

/* h1: 본문 페이지 제목 */
body.page.viewcontent .wiki-content h1,
#content .wiki-content h1 {
  margin: 0 0 var(--kc-content-gap-lg);
  padding: 0;
  border: 0;
  font-size: var(--kc-font-4xl);
  font-weight: var(--kc-weight-bold);
  line-height: var(--kc-line-tight);
}

/* h2: 시나리오 소개 / 시작하기 전에 / 작업 방식 선택 */
body.page.viewcontent .wiki-content h2,
#content .wiki-content h2 {
  margin-top: var(--kc-content-gap-3xl);
  margin-bottom: var(--kc-content-gap-lg);
  padding: 0;
  border: 0;
  font-size: 26px;
  font-weight: var(--kc-weight-bold);
  line-height: 1.4;
}

/* h3: STEP 1, STEP 2, STEP 3 */
body.page.viewcontent .wiki-content h3,
#content .wiki-content h3 {
  margin-top: 44px;
  margin-bottom: var(--kc-content-gap-md);
  padding: 0;
  border: 0;
  color: var(--kc-text-heading);
  font-size: var(--kc-font-xl);
  font-weight: var(--kc-weight-bold);
  line-height: var(--kc-line-heading);
}

/* h4: 콘솔에서 작업 / 인스턴스 터미널에서 작업 */
body.page.viewcontent .wiki-content h4,
#content .wiki-content h4 {
  margin-top: var(--kc-content-gap-xl);
  margin-bottom: var(--kc-content-gap-sm);
  padding: 0;
  border: 0;
  color: #303030;
  font-size: var(--kc-font-md);
  font-weight: var(--kc-weight-bold);
  line-height: 1.55;
}

/* h5 / h6: 세부 확인 항목 */
body.page.viewcontent .wiki-content h5,
#content .wiki-content h5 {
  margin-top: var(--kc-content-gap-lg);
  margin-bottom: var(--kc-content-gap-xs);
  color: var(--kc-text-default);
  font-size: var(--kc-font-sm);
  font-weight: var(--kc-weight-bold);
  line-height: 1.55;
}

body.page.viewcontent .wiki-content h6,
#content .wiki-content h6 {
  margin-top: var(--kc-content-gap-md);
  margin-bottom: var(--kc-content-gap-xs);
  color: var(--kc-text-subtle);
  font-size: var(--kc-font-xs);
  font-weight: var(--kc-weight-semibold);
  line-height: 1.5;
}


/* =====================================================================
   05. BODY TEXT / LINK / EMPHASIS
   ===================================================================== */
body.page.viewcontent .wiki-content p,
#content .wiki-content p {
  margin-top: 0;
  margin-bottom: var(--kc-content-gap-md);
  color: var(--kc-text-default);
  font-family: var(--kc-font);
  font-size: var(--kc-font-md);
  font-weight: var(--kc-weight-regular);
  line-height: var(--kc-line-body);
}

body.page.viewcontent .wiki-content strong,
body.page.viewcontent .wiki-content b,
#content .wiki-content strong,
#content .wiki-content b {
  color: var(--kc-text-strong);
  font-weight: var(--kc-weight-bold);
}

body.page.viewcontent .wiki-content em,
body.page.viewcontent .wiki-content i,
#content .wiki-content em,
#content .wiki-content i {
  color: inherit;
  font-style: normal;
}

body.page.viewcontent .wiki-content del,
body.page.viewcontent .wiki-content s,
#content .wiki-content del,
#content .wiki-content s {
  color: var(--kc-text-subtle);
}

body.page.viewcontent .wiki-content a,
#content .wiki-content a {
  color: var(--kc-link-default);
  font-weight: var(--kc-weight-regular);
  text-decoration: none;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

body.page.viewcontent .wiki-content a:hover,
#content .wiki-content a:hover {
  color: var(--kc-link-hover);
  text-decoration: underline;
}

body.page.viewcontent .wiki-content a:visited,
#content .wiki-content a:visited {
  color: var(--kc-link-visited);
}


/* =====================================================================
   06. INTRO / LEAD PARAGRAPH
   제목 직후 요약문, blockquote 문단
   ===================================================================== */
body.page.viewcontent .wiki-content > blockquote,
#content .wiki-content > blockquote,
body.page.viewcontent .wiki-content h1 + p em,
#content .wiki-content h1 + p em {
  display: block;
  margin: 4px 0 var(--kc-content-gap-xl);
  padding: 0 0 0 16px;
  border: 0;
  border-left: 2px solid #d8d8d8;
  border-radius: 0;
  background: transparent;
  color: var(--kc-text-subtle);
  font-family: var(--kc-font);
  font-size: var(--kc-font-md);
  font-style: normal;
  font-weight: var(--kc-weight-regular);
  line-height: 1.75;
}

body.page.viewcontent .wiki-content > blockquote p,
#content .wiki-content > blockquote p {
  margin: 0;
  color: inherit;
}


/* =====================================================================
   07. LIST SYSTEM
   ===================================================================== */
body.page.viewcontent .wiki-content ul,
body.page.viewcontent .wiki-content ol,
#content .wiki-content ul,
#content .wiki-content ol {
  margin-top: 8px;
  margin-bottom: 20px;
  padding-left: 24px;
  color: var(--kc-text-default);
  font-family: var(--kc-font);
  font-size: var(--kc-font-md);
  font-weight: var(--kc-weight-regular);
  line-height: var(--kc-line-body);
}

body.page.viewcontent .wiki-content ul > li,
#content .wiki-content ul > li {
  margin-bottom: 6px;
  padding-left: 2px;
}

body.page.viewcontent .wiki-content ol > li,
#content .wiki-content ol > li {
  margin-bottom: 8px;
  padding-left: 2px;
}

body.page.viewcontent .wiki-content ol > li::marker,
#content .wiki-content ol > li::marker {
  color: var(--kc-text-strong);
  font-weight: var(--kc-weight-semibold);
}

body.page.viewcontent .wiki-content ul > li::marker,
#content .wiki-content ul > li::marker {
  color: var(--kc-text-subtle);
}

body.page.viewcontent .wiki-content li > ul,
body.page.viewcontent .wiki-content li > ol,
#content .wiki-content li > ul,
#content .wiki-content li > ol {
  margin-top: 5px;
  margin-bottom: 5px;
  color: var(--kc-text-default);
}

body.page.viewcontent .wiki-content input[type="checkbox"],
#content .wiki-content input[type="checkbox"] {
  width: 15px;
  height: 15px;
  margin: 0 5px 0 0;
  accent-color: var(--kc-blue-700);
  vertical-align: -2px;
}


/* =====================================================================
   08. HORIZONTAL RULE
   ===================================================================== */
body.page.viewcontent .wiki-content hr,
#content .wiki-content hr {
  height: 1px;
  margin: var(--kc-content-gap-2xl) 0;
  border: 0;
  background: var(--kc-border-default);
}


/* =====================================================================
   09. TABLE SYSTEM
   ===================================================================== */
.wiki-content .table-wrap,
#content .wiki-content .table-wrap {
  max-width: 100%;
  margin: 20px 0 28px;
  overflow-x: auto;
  border-radius: var(--kc-radius-sm);
}

.wiki-content table.confluenceTable,
.wiki-content table.confluenceTable.tablesorter,
#content .wiki-content table.confluenceTable,
#content .wiki-content table.confluenceTable.tablesorter {
  width: 100% !important;
  margin: 20px 0 28px !important;
  overflow: hidden;
  border: 1px solid var(--kc-border-default) !important;
  border-collapse: separate !important;
  border-spacing: 0 !important;
  border-radius: var(--kc-radius-sm) !important;
  background: var(--kc-surface-base) !important;
  box-shadow: none !important;
}

/* Table header */
.wiki-content table.confluenceTable th,
.wiki-content table.confluenceTable th.confluenceTh,
.wiki-content table.confluenceTable.tablesorter th.confluenceTh,
#content .wiki-content table.confluenceTable th,
#content .wiki-content table.confluenceTable th.confluenceTh,
#content .wiki-content table.confluenceTable.tablesorter th.confluenceTh {
  padding: 13px 16px !important;
  border-top: 0 !important;
  border-right: 0 !important;
  border-bottom: 1px solid var(--kc-border-default) !important;
  border-left: 1px solid var(--kc-border-default) !important;
  background: #f7f8fa !important;
  color: #303030 !important;
  font-family: var(--kc-font) !important;
  font-size: var(--kc-font-sm) !important;
  font-weight: var(--kc-weight-semibold) !important;
  line-height: 1.5 !important;
  text-align: left !important;
  vertical-align: middle !important;
}

.wiki-content table.confluenceTable th:first-child,
#content .wiki-content table.confluenceTable th:first-child {
  border-left: 0 !important;
}

/* Sort button / header wrapper */
.wiki-content table.confluenceTable th .tablesorter-header-inner,
.wiki-content table.confluenceTable th .headerButton,
.wiki-content table.confluenceTable th button,
#content .wiki-content table.confluenceTable th .tablesorter-header-inner,
#content .wiki-content table.confluenceTable th .headerButton,
#content .wiki-content table.confluenceTable th button {
  padding: 0 !important;
  margin: 0 !important;
  border: 0 !important;
  background: transparent !important;
  color: #303030 !important;
  font-family: var(--kc-font) !important;
  font-size: var(--kc-font-sm) !important;
  font-weight: var(--kc-weight-semibold) !important;
  text-align: left !important;
}

/* Table body */
.wiki-content table.confluenceTable td,
.wiki-content table.confluenceTable td.confluenceTd,
.wiki-content table.confluenceTable.tablesorter tbody tr td,
#content .wiki-content table.confluenceTable td,
#content .wiki-content table.confluenceTable td.confluenceTd,
#content .wiki-content table.confluenceTable.tablesorter tbody tr td {
  padding: 14px 16px !important;
  border-top: 0 !important;
  border-right: 0 !important;
  border-bottom: 1px solid var(--kc-border-default) !important;
  border-left: 1px solid var(--kc-border-default) !important;
  background: var(--kc-surface-base) !important;
  color: var(--kc-text-default) !important;
  font-family: var(--kc-font) !important;
  font-size: var(--kc-font-sm) !important;
  font-weight: var(--kc-weight-regular) !important;
  line-height: 1.65 !important;
  text-align: left !important;
  vertical-align: top !important;
  word-break: keep-all !important;
}

.wiki-content table.confluenceTable td:first-child,
#content .wiki-content table.confluenceTable td:first-child {
  border-left: 0 !important;
}

.wiki-content table.confluenceTable tr:last-child td,
#content .wiki-content table.confluenceTable tr:last-child td {
  border-bottom: 0 !important;
}

/* Zebra striping 제거 */
.wiki-content table.confluenceTable tr,
.wiki-content table.confluenceTable tr:nth-child(even) td,
.wiki-content table.confluenceTable tr:nth-child(odd) td,
.wiki-content table.confluenceTable.tablesorter tbody tr:nth-child(even) td,
.wiki-content table.confluenceTable.tablesorter tbody tr:nth-child(odd) td,
#content .wiki-content table.confluenceTable tr,
#content .wiki-content table.confluenceTable tr:nth-child(even) td,
#content .wiki-content table.confluenceTable tr:nth-child(odd) td {
  background: var(--kc-surface-base) !important;
}

/* 짧은 식별자 열의 줄바꿈 방지 */
.wiki-content table.confluenceTable th:first-child,
.wiki-content table.confluenceTable td:first-child,
#content .wiki-content table.confluenceTable th:first-child,
#content .wiki-content table.confluenceTable td:first-child {
  white-space: nowrap;
}

/* 표 내부 문단 여백 축소 */
.wiki-content table.confluenceTable p,
#content .wiki-content table.confluenceTable p {
  margin: 0 0 8px !important;
  font-size: inherit !important;
  line-height: inherit !important;
}

.wiki-content table.confluenceTable p:last-child,
#content .wiki-content table.confluenceTable p:last-child {
  margin-bottom: 0 !important;
}


/* =====================================================================
   10. INLINE CODE
   KakaoCloud reference:
   - 14px
   - font-weight 500
   - border-radius 4px
   - compact gray surface
   ===================================================================== */
body.page.viewcontent .wiki-content code,
#content .wiki-content code {
  display: inline;
  padding: 2px 6px;
  border: 1px solid #e4e6ea;
  border-radius: var(--kc-radius-xs);
  background: #f5f6f8;
  color: #303030;
  font-family: var(--kc-mono);
  font-size: 0.875em;
  font-weight: var(--kc-weight-medium);
  line-height: 1.5;
  word-break: break-word;
}


/* =====================================================================
   11. CODE BLOCKS
   ===================================================================== */

/* Confluence code macro outer wrapper */
body.page.viewcontent .wiki-content div.code.panel,
#content .wiki-content div.code.panel,
body.page.viewcontent .wiki-content .codeContent,
#content .wiki-content .codeContent {
  max-width: 100%;
  margin: 20px 0 24px;
  overflow: hidden;
  border: 1px solid var(--kc-border-code) !important;
  border-radius: var(--kc-radius-sm) !important;
  background: var(--kc-surface-code) !important;
  box-shadow: none !important;
}

/* Confluence code macro header */
body.page.viewcontent .wiki-content div.code.panel .codeHeader,
#content .wiki-content div.code.panel .codeHeader {
  min-height: 36px;
  padding: 8px 14px !important;
  border: 0 !important;
  border-bottom: 1px solid var(--kc-border-code) !important;
  background: var(--kc-surface-code-header) !important;
  color: var(--kc-text-subtle) !important;
  font-family: var(--kc-font) !important;
  font-size: var(--kc-font-xs) !important;
  font-weight: var(--kc-weight-medium) !important;
  line-height: 20px !important;
}

/* 일반 pre 및 Code macro 내부 pre */
body.page.viewcontent .wiki-content div.code.panel pre,
#content .wiki-content div.code.panel pre,
body.page.viewcontent .wiki-content .codeContent pre,
#content .wiki-content .codeContent pre,
body.page.viewcontent .wiki-content pre,
#content .wiki-content pre {
  max-width: 100%;
  margin: 0 !important;
  padding: 18px 20px !important;
  overflow-x: auto !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: var(--kc-surface-code) !important;
  color: #393a34 !important;
  box-sizing: border-box !important;
  font-family: var(--kc-mono) !important;
  font-size: 13px !important;
  font-weight: var(--kc-weight-regular) !important;
  line-height: var(--kc-line-code) !important;
  tab-size: 2;
  white-space: pre !important;
}

/* 일반 pre가 Code macro 밖에 있을 때만 외곽 카드 적용 */
body.page.viewcontent .wiki-content > pre,
#content .wiki-content > pre,
body.page.viewcontent .wiki-content p + pre,
#content .wiki-content p + pre {
  margin: 20px 0 24px !important;
  border: 1px solid var(--kc-border-code) !important;
  border-radius: var(--kc-radius-sm) !important;
}

/* 코드 내부 code는 inline-code badge 효과 제거 */
body.page.viewcontent .wiki-content pre code,
#content .wiki-content pre code {
  display: block;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  color: inherit !important;
  font-family: inherit !important;
  font-size: inherit !important;
  font-weight: var(--kc-weight-regular) !important;
  line-height: inherit !important;
  white-space: inherit !important;
}

/* Syntax token: KakaoCloud reference Prism palette */
body.page.viewcontent .wiki-content .token.comment,
#content .wiki-content .token.comment {
  color: #999988 !important;
  font-style: italic;
}

