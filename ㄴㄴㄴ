/* =====================================================================
   KakaoCloud Tutorial Refinement Patch v2
   - 기존 CSS의 맨 마지막에 추가
   - 이전에 추가한 mention/TOC 패치가 있다면 삭제하고 이 파일로 교체
   ===================================================================== */

/* ---------------------------------------------------------------------
   1. Tutorial information hierarchy
   카카오클라우드 튜토리얼의 핵심은 "짧은 개요 → 단계별 수행 → 검증" 흐름입니다.
   h2는 시나리오 단위, h3는 Step 단위, h4는 실행 방법 단위로 명확히 구분합니다.
   --------------------------------------------------------------------- */
:root {
  --kc-tutorial-accent: #3182f6;
  --kc-tutorial-accent-soft: #eaf3ff;
  --kc-toc-line: #e7e7e7;
  --kc-toc-indent: 12px;
}

body.page.viewcontent .wiki-content h3,
#content .wiki-content h3 {
  position: relative;
  margin-top: 44px;
  padding-top: 4px;
  color: var(--kc-text-heading);
}

/* ---------------------------------------------------------------------
   2. Mention — @를 CSS에서 보장
   Confluence가 사용자 표시명만 렌더링하는 경우에도 @사용자명으로 표시합니다.
   --------------------------------------------------------------------- */
body.page.viewcontent .wiki-content a.confluence-userlink,
#content .wiki-content a.confluence-userlink,
body.page.viewcontent .wiki-content .user-mention,
#content .wiki-content .user-mention,
body.page.viewcontent .wiki-content [data-mention-id],
#content .wiki-content [data-mention-id] {
  display: inline-flex;
  align-items: baseline;
  gap: 1px;
  color: var(--kc-link-default) !important;
  font-weight: var(--kc-weight-medium) !important;
  white-space: nowrap;
}

body.page.viewcontent .wiki-content a.confluence-userlink::before,
#content .wiki-content a.confluence-userlink::before,
body.page.viewcontent .wiki-content .user-mention::before,
#content .wiki-content .user-mention::before,
body.page.viewcontent .wiki-content [data-mention-id]::before,
#content .wiki-content [data-mention-id]::before {
  content: "@";
  color: currentColor;
  font-family: var(--kc-font);
  font-weight: var(--kc-weight-semibold);
}

/* =====================================================================
   TOC REPLACEMENT — 실제 Wiki DOM 기준

   적용 전:
   1) 기존 CSS의 "15. TABLE OF CONTENTS" 전체를 삭제
   2) 이전에 붙인 TOC patch도 삭제
   3) 이 블록을 CSS 파일의 마지막에 붙여넣기

   확인된 DOM hook:
   - .toc-item-body[data-outline]
   - .toc-outline
   - .toc-link
   ===================================================================== */

:root {
  --kc-toc-text: #626262;
  --kc-toc-text-strong: #202020;
  --kc-toc-text-active: #3182f6;
  --kc-toc-rail: #dedede;
  --kc-toc-branch: #e9e9e9;
  --kc-toc-indent: 14px;
}

/* TOC의 root ul과 모든 하위 ul을 정확히 대상으로 지정 */
#content ul:has(> li > .toc-item-body),
#content ul:has(> li > .toc-item-body) ul,
.wiki-content ul:has(> li > .toc-item-body),
.wiki-content ul:has(> li > .toc-item-body) ul {
  display: block;
  margin: 0;
  padding: 0;
  list-style: none;
}

/* TOC root: 카카오클라우드 문서처럼 얇은 좌측 rail만 사용 */
#content > ul:has(> li > .toc-item-body),
.wiki-content > ul:has(> li > .toc-item-body),
#content .toc-macro > ul:has(> li > .toc-item-body),
.wiki-content .toc-macro > ul:has(> li > .toc-item-body) {
  padding: 2px 0 2px 16px;
  border-left: 1px solid var(--kc-toc-rail);
}

#content ul:has(> li > .toc-item-body) li,
.wiki-content ul:has(> li > .toc-item-body) li {
  display: block;
  margin: 0;
  padding: 0;
  list-style: none;
}

/* 생성 번호는 숨김: 제목 안의 "STEP 1." 또는 "1."와 중복되지 않게 함 */
#content .toc-outline,
.wiki-content .toc-outline {
  display: none;
}

/* 한 항목 = 링크 하나. 기존 li 여백/폰트 규칙의 영향을 차단 */
#content .toc-item-body,
.wiki-content .toc-item-body {
  display: block;
  min-width: 0;
  margin: 0;
  padding: 0;
}

/* 최상위 링크: 시나리오·주요 Step */
#content > ul:has(> li > .toc-item-body) > li > .toc-item-body > .toc-link,
.wiki-content > ul:has(> li > .toc-item-body) > li > .toc-item-body > .toc-link,
#content .toc-macro > ul:has(> li > .toc-item-body) > li > .toc-item-body > .toc-link,
.wiki-content .toc-macro > ul:has(> li > .toc-item-body) > li > .toc-item-body > .toc-link {
  display: block;
  padding: 5px 0;
  color: var(--kc-toc-text-strong) !important;
  font-family: var(--kc-font);
  font-size: 13px;
  font-weight: 600;
  line-height: 1.45;
  text-decoration: none !important;
  overflow-wrap: anywhere;
}

/* 하위 ul: 같은 줄이 아니라 독립적인 outline branch로 표현 */
#content ul:has(> li > .toc-item-body) li > ul,
.wiki-content ul:has(> li > .toc-item-body) li > ul {
  display: block;
  margin: 2px 0 5px 7px;
  padding: 0 0 0 var(--kc-toc-indent);
  border-left: 1px solid var(--kc-toc-branch);
}

/* 하위 링크: 세부 절차. 한 단계 작고 가볍게 표현 */
#content ul:has(> li > .toc-item-body) li > ul > li > .toc-item-body > .toc-link,
.wiki-content ul:has(> li > .toc-item-body) li > ul > li > .toc-item-body > .toc-link {
  display: block;
  padding: 3px 0;
  color: var(--kc-toc-text) !important;
  font-family: var(--kc-font);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.5;
  text-decoration: none !important;
  overflow-wrap: anywhere;
}

/* 3단계부터는 깊이를 좁게 유지: 모바일에서 계단식 공백 방지 */
#content ul:has(> li > .toc-item-body) li > ul li > ul,
.wiki-content ul:has(> li > .toc-item-body) li > ul li > ul {
  margin-left: 5px;
  padding-left: 10px;
}

/* hover / 현재 위치. Wiki가 aria-current를 넣는 경우도 함께 대응 */
#content .toc-link:hover,
.wiki-content .toc-link:hover,
#content .toc-link[aria-current="true"],
.wiki-content .toc-link[aria-current="true"],
#content .toc-link[aria-current="location"],
.wiki-content .toc-link[aria-current="location"] {
  color: var(--kc-toc-text-active) !important;
  font-weight: 600;
  text-decoration: none !important;
}

/* 모바일에서는 TOC root rail만 조금 좁게 */
@media (max-width: 768px) {
  #content > ul:has(> li > .toc-item-body),
  .wiki-content > ul:has(> li > .toc-item-body),
  #content .toc-macro > ul:has(> li > .toc-item-body),
  .wiki-content .toc-macro > ul:has(> li > .toc-item-body) {
    padding-left: 12px;
  }

  #content ul:has(> li > .toc-item-body) li > ul,
  .wiki-content ul:has(> li > .toc-item-body) li > ul {
    margin-left: 5px;
    padding-left: 10px;
  }
}

/* Dark mode */
html[data-color-mode="dark"],
body.aui-theme-dark {
  --kc-toc-text: #aab4c0;
  --kc-toc-text-strong: #e5e7eb;
  --kc-toc-text-active: #7db5ff;
  --kc-toc-rail: #3a4552;
  --kc-toc-branch: #303b48;
}
